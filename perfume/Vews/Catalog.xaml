<Page x:Class="perfume.Vews.Catalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:perfume.Vews"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="White"
      Title="Catalog">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="200*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Background="#FFFACD">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>
            <Image Source="/image/icon.png"/>
            <TextBlock Grid.Column="1" Text="Список товаров" Style="{StaticResource ResourceKey=tbTitle}"/>
            <Button Grid.Column="3" Name="btnBack" Content="Назад" Click="btnExit_Click"/>
            <TextBlock Grid.Column="2" x:Name="tbUser" Text="???" HorizontalAlignment="Center" Style="{StaticResource tbText}"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ListBox Name="lbTovar" MouseDoubleClick="lbTovar_MouseDoubleClick" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <Border Margin="5" BorderBrush="Black" BorderThickness="1">
                                    <Image Margin="5" Source="{Binding Path=PhotoCurrent}"/>
                                </Border>
                                <Border Margin="5" Grid.Column="1" BorderBrush="Black" BorderThickness="1">
                                    <StackPanel Margin="5" Orientation="Vertical">
                                        <TextBlock HorizontalAlignment="Center" FontWeight="Heavy" Style="{StaticResource tbText}">
                                            <Run Text="{Binding Path=NameTovar.TovarName}"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding Path=Category.NameCategory}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource tbText}">
                                            <Run Text="Описание товара: "/>
                                            <Run Text="{Binding Path=Description}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource tbText}">
                                            <Run Text="Производитель: "/>
                                            <Run Text="{Binding Path=Manufacture.NameManufacture}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource tbText}">
                                            <Run Text="Поставщик: "/>
                                            <Run Text="{Binding Path=Provider.NameProvider}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource tbText}">
                                            <Run Text="Цена: "/>
                                            <Run Text="{Binding Path=Price}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource tbText}">
                                            <Run Text="Единица измерения: "/>
                                            <Run Text="{Binding Path=Unit.NameUnit}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource tbText}">
                                            <Run Text="Кол-во на складе: "/>
                                            <Run Text="{Binding Path=Count}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border  Grid.Column="2" Margin="5" BorderBrush="Black" BorderThickness="1" >
                                    <StackPanel Orientation="Vertical" Margin="0,70,0,0">
                                        <TextBlock TextAlignment="Center" Style="{StaticResource tbText}">
                                        <Run Text="Действующая"/>
                                        <LineBreak/>
                                        <Run Text="скидка:"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Path=Discount}" Margin="0,0,0,100" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource tbText}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Name="GridSearch" Visibility="Collapsed" Grid.Column="1" BorderBrush="Black" BorderThickness="1">
                <StackPanel Orientation="Vertical">
                    <TextBlock Margin="10" Text="Поиск" Style="{StaticResource tbTitle}"/>
                    <TextBox Name="tbSearch" Style="{StaticResource tbMain}" Margin="10,0,10,0" TextChanged="tbSearch_TextChanged"/>
                    <TextBlock FontSize="16" Text="Фильтрация по поставщикам:" Style="{StaticResource tbText}" Margin="10,5,10,0"/>
                    <ComboBox Name="cbProvider"
                                  SelectedIndex="0"
                                  SelectedValuePath="IDProvider"
                                  DisplayMemberPath="NameProvider" Style="{StaticResource cbMain}" Margin="10,5,10,0" SelectionChanged="cbProvider_SelectionChanged"/>
                    <TextBlock FontSize="16" Text="Сортировка по количеству на складе:" Style="{StaticResource tbText}" Margin="10,5,10,0"/>
                    <RadioButton Name="rbUp" Content="По возрастанию" GroupName="Sort" Margin="10,5,10,0" Style="{StaticResource rbMain}" Checked="rbUp_Checked"/>
                    <RadioButton Name="rbDown" Content="По убыванию" GroupName="Sort" Margin="10,5,10,0" Style="{StaticResource rbMain}" Checked="rbDown_Checked"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Name="footter"  Grid.Row="2" Visibility="Collapsed" Background="#FFFACD">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnAddTovar" Content="Добавить товар" Click="btnAddTovar_Click" />
            <Button Grid.Column="1" x:Name="btnDelTovar" Content="Удалить товар" />
            <Button Grid.Column="2" x:Name="btnOrder" Content="Заказы" />
        </Grid>
    </Grid>
</Page>
