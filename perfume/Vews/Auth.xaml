<Page x:Class="perfume.Vews.Auth"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:perfume.Vews"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="White"
      Title="Auth">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="200*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Background="#FFFACD">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20*"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>
            <Image Source="/image/icon.png"/>
            <TextBlock Grid.Column="1" Text="Авторизация" Style="{StaticResource ResourceKey=tbTitle}"/>
            <Button Grid.Column="2" Name="btnExit" Content="Выход" Click="btnExit_Click"/>
        </Grid>
        <UniformGrid Grid.Row="1">
            <TextBlock Text="Логин" Style="{StaticResource ResourceKey=tbTitle}"/>
            <TextBox Name="tbLogin" Text="o@outlook.com" Style="{StaticResource ResourceKey=tbMain}"/>
            <TextBlock Text="Пароль" Style="{StaticResource ResourceKey=tbTitle}"/>
            <TextBox Name="tbPassword" Text="2L6KZG" Style="{StaticResource ResourceKey=tbMain}"/>
        </UniformGrid>
        <Grid Grid.Row="2" Visibility="Visible" Background="#FFFACD">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnGuest" Content="Гость" Click="btnGuest_Click"/>
            <Button Grid.Column="1" x:Name="btnLogin" Content="Вход" Click="btnLogin_Click"/>
        </Grid>
    </Grid>
</Page>
